#!/usr/bin/env bash

local_branches="$(git branch --sort=-committerdate)"
remote_branches="$(git branch --remotes --sort=-committerdate)"
all_branches="$local_branches\n$remote_branches\n"
echo -e "$all_branches" \
  | rg -v '^\*' \
  | rg -v '^\+' \
  | rg -v '^\s+$' \
  | sed 's/^  //' \
  | fzf \
  | sed 's/origin\///'
